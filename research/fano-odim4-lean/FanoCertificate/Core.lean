def pat7 : Finset (Fin 7) := {(6 : Fin 7)}
def pat123 : Finset (Fin 7) := {(0 : Fin 7), 1, 2}
def pat145 : Finset (Fin 7) := {(0 : Fin 7), 3, 4}
def pat167 : Finset (Fin 7) := {(0 : Fin 7), 5, 6}
def pat246 : Finset (Fin 7) := {(1 : Fin 7), 3, 5}
def pat257 : Finset (Fin 7) := {(1 : Fin 7), 4, 6}
def pat347 : Finset (Fin 7) := {(2 : Fin 7), 3, 6}
def pat356 : Finset (Fin 7) := {(2 : Fin 7), 4, 5}

def FPSet : Set (Finset (Fin 7)) :=
  {s | s = patEmpty ∨
       s = pat1 ∨
       s = pat2 ∨
       s = pat3 ∨
       s = pat4 ∨
       s = pat5 ∨
       s = pat6 ∨
       s = pat7 ∨
       s = pat123 ∨
       s = pat145 ∨
       s = pat167 ∨
       s = pat246 ∨
       s = pat257 ∨
       s = pat347 ∨
       s = pat356}

def Code : Set (Finset (Fin 7)) :=
  {s | ∃ x, HasPattern x s}

