def U : Fin 7 → Point → Prop := ![U1, U2, U3, U4, U5, U6, U7]

def HasPattern (x : Point) (s : Finset (Fin 7)) : Prop :=
  ∀ i, U i x ↔ i ∈ s

def patEmpty : Finset (Fin 7) := ∅
def pat1 : Finset (Fin 7) := {(0 : Fin 7)}
def pat2 : Finset (Fin 7) := {(1 : Fin 7)}
def pat3 : Finset (Fin 7) := {(2 : Fin 7)}
